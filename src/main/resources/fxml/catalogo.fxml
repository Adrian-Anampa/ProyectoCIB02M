<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760" prefWidth="1180" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.objetoshallados.controller.CatalogController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <Label styleClass="top-brand" text="ENCUENTRA+"/><Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onMenu" styleClass="button-ghost" text="Inicio"/>
            <Button onAction="#onPublish" styleClass="button-ghost" text="Publicar"/>
            <Button onAction="#onClaims" styleClass="button-ghost" text="Mis reclamos"/>
            <Button onAction="#onLogout" styleClass="button-ghost" text="Cerrar sesión"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" styleClass="page-shell">
            <VBox spacing="4"><Label styleClass="eyebrow" text="CATÁLOGO"/><Label styleClass="page-title" text="Objetos encontrados"/><Label styleClass="muted-text" text="Usa uno o varios filtros para encontrar lo que buscas."/></VBox>
            <VBox spacing="12" styleClass="filter-panel">
                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Palabra clave"/><TextField fx:id="searchField" onAction="#onSearch" promptText="Ej. mochila, audífonos..."/></VBox>
                    <VBox spacing="5" prefWidth="170"><Label styleClass="field-label" text="Categoría"/><ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308"/></VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Lugar"/><TextField fx:id="locationField" onAction="#onSearch" promptText="Ej. Biblioteca"/></VBox>
                    <VBox spacing="5" prefWidth="160"><Label styleClass="field-label" text="Fecha"/><DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308"/></VBox>
                    <VBox spacing="5" prefWidth="165"><Label styleClass="field-label" text="Estado"/><ComboBox fx:id="statusCombo" maxWidth="1.7976931348623157E308" promptText="Todos"/></VBox>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="9"><Button onAction="#onClear" styleClass="button-secondary" text="Limpiar"/><Button onAction="#onSearch" styleClass="button-primary" text="Buscar"/></HBox>
            </VBox>
            <HBox alignment="CENTER_LEFT"><Label fx:id="resultLabel" styleClass="muted-text"/><Region HBox.hgrow="ALWAYS"/><Label styleClass="helper-text" text="Doble clic para abrir el detalle"/></HBox>
            <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" prefWidth="250" text="Objeto"/>
                    <TableColumn fx:id="categoryColumn" prefWidth="150" text="Categoría"/>
                    <TableColumn fx:id="locationColumn" prefWidth="240" text="Lugar"/>
                    <TableColumn fx:id="dateColumn" prefWidth="140" text="Fecha"/>
                    <TableColumn fx:id="statusColumn" prefWidth="150" text="Estado"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10"><Button onAction="#onMenu" styleClass="button-secondary" text="Volver al inicio"/><Button onAction="#onOpenDetail" styleClass="button-primary" text="Ver detalle"/></HBox>
        </VBox>
    </center>
</BorderPane>
