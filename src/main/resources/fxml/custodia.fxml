<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760" prefWidth="1180" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.objetoshallados.controller.CustodyController">
    <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar"><Label styleClass="top-brand" text="ENCUENTRA+"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#onMenu" styleClass="button-ghost" text="Inicio"/><Button onAction="#onCatalog" styleClass="button-ghost" text="Catálogo"/></HBox></top>
    <center>
        <StackPane styleClass="page-shell">
            <VBox maxWidth="720" spacing="20" styleClass="content-card">
                <VBox spacing="4"><Label styleClass="eyebrow" text="VERIFICACIÓN DE CUSTODIA"/><Label styleClass="page-title" text="Demuestra que el objeto es tuyo"/><Label styleClass="muted-text" text="Tu respuesta solo será visible para el personal autorizado."/></VBox>
                <VBox spacing="5"><Label styleClass="helper-text" text="OBJETO"/><Label fx:id="objectLabel" styleClass="section-title"/></VBox>
                <VBox spacing="8" styleClass="filter-panel"><Label styleClass="field-label" text="Pregunta de verificación"/><Label fx:id="questionLabel" maxWidth="650" styleClass="card-title" wrapText="true"/></VBox>
                <VBox spacing="6"><Label styleClass="field-label" text="Tu respuesta *"/><TextArea fx:id="answerArea" prefRowCount="5" promptText="Incluye detalles precisos que permitan confirmar que eres el propietario..." wrapText="true"/><Label styleClass="helper-text" text="Evita compartir contraseñas u otra información sensible."/></VBox>
                <Label fx:id="messageLabel" minHeight="22" styleClass="form-message message-error" wrapText="true"/>
                <HBox alignment="CENTER_RIGHT" spacing="10"><Button onAction="#onBack" styleClass="button-secondary" text="Cancelar"/><Button onAction="#onSubmitClaim" styleClass="button-primary" text="Enviar reclamo"/></HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
