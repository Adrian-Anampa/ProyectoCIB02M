<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760" prefWidth="1180" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.objetoshallados.controller.IndicatorsController">
    <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar"><Label styleClass="top-brand" text="ENCUENTRA+ ADMIN"/><Region HBox.hgrow="ALWAYS"/><Button onAction="#onAdmin" styleClass="button-ghost" text="Panel"/><Button onAction="#onMenu" styleClass="button-ghost" text="Vista general"/><Button onAction="#onLogout" styleClass="button-ghost" text="Cerrar sesión"/></HBox></top>
    <center>
        <VBox spacing="16" styleClass="page-shell">
            <VBox spacing="4"><Label styleClass="eyebrow" text="ANALÍTICA"/><Label styleClass="page-title" text="Indicadores del sistema"/><Label styleClass="muted-text" text="Resumen visual de objetos y reclamos registrados."/></VBox>
            <HBox spacing="16"><VBox HBox.hgrow="ALWAYS" spacing="5" styleClass="stat-card"><Label fx:id="availableLabel" styleClass="stat-value"/><Label styleClass="stat-caption" text="DISPONIBLES"/></VBox><VBox HBox.hgrow="ALWAYS" spacing="5" styleClass="stat-card"><Label fx:id="pendingLabel" styleClass="stat-value"/><Label styleClass="stat-caption" text="RECLAMOS PENDIENTES"/></VBox><VBox HBox.hgrow="ALWAYS" spacing="5" styleClass="stat-card"><Label fx:id="returnedLabel" styleClass="stat-value"/><Label styleClass="stat-caption" text="DEVUELTOS"/></VBox></HBox>
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="content-card"><Label styleClass="card-title" text="Distribución por estado"/><PieChart fx:id="statusChart" labelsVisible="true" legendSide="BOTTOM" VBox.vgrow="ALWAYS"/></VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="content-card"><Label styleClass="card-title" text="Objetos por categoría"/><BarChart fx:id="categoryChart" animated="false" legendVisible="false" VBox.vgrow="ALWAYS"><xAxis><CategoryAxis label="Categoría"/></xAxis><yAxis><NumberAxis forceZeroInRange="true" label="Cantidad" tickUnit="1"/></yAxis></BarChart></VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
