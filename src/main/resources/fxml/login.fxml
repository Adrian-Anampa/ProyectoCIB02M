<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.objetoshallados.controller.LoginController">
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="520.0" spacing="22.0" styleClass="brand-panel">
            <padding><Insets bottom="70" left="64" right="64" top="70"/></padding>
            <Label styleClass="brand-mark" text="ENCUENTRA+"/>
            <Label maxWidth="380" styleClass="hero-title" text="Lo que se pierde, puede volver." wrapText="true"/>
            <Label maxWidth="380" styleClass="hero-copy" text="Publica, identifica y recupera objetos encontrados dentro de tu comunidad educativa." wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label styleClass="hero-note" text="Seguro · Ordenado · Colaborativo"/>
        </VBox>
    </left>
    <center>
        <StackPane styleClass="page-background">
            <VBox maxWidth="430" spacing="18" styleClass="auth-card">
                <Label styleClass="eyebrow" text="BIENVENIDO"/>
                <Label styleClass="page-title" text="Inicia sesión"/>
                <Label styleClass="muted-text" text="Accede al catálogo y revisa tus reclamos."/>
                <VBox spacing="7">
                    <Label styleClass="field-label" text="Correo electrónico *"/>
                    <TextField fx:id="emailField" onAction="#onLogin" promptText="nombre@institucion.edu.pe"/>
                </VBox>
                <VBox spacing="7">
                    <Label styleClass="field-label" text="Contraseña *"/>
                    <StackPane>
                        <PasswordField fx:id="passwordField" onAction="#onLogin" promptText="Ingresa tu contraseña"/>
                        <TextField fx:id="visiblePasswordField" onAction="#onLogin" promptText="Ingresa tu contraseña" visible="false"/>
                    </StackPane>
                    <CheckBox fx:id="showPasswordCheck" text="Mostrar contraseña"/>
                </VBox>
                <Label fx:id="messageLabel" minHeight="22" styleClass="form-message" wrapText="true"/>
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#onLogin" styleClass="button-primary" text="Ingresar" HBox.hgrow="ALWAYS"/>
                    <ProgressIndicator fx:id="loadingIndicator" maxHeight="28" maxWidth="28" prefHeight="28" prefWidth="28" progress="-1"/>
                </HBox>
                <HBox alignment="CENTER" spacing="5">
                    <Label text="¿Aún no tienes cuenta?"/>
                    <Hyperlink onAction="#onRegister" text="Regístrate"/>
                </HBox>
                <Separator/>
                <Label styleClass="demo-title" text="Accesos de demostración"/>
                <HBox spacing="10">
                    <Button onAction="#useStudentDemo" styleClass="button-secondary" text="Cargar estudiante" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                    <Button onAction="#useAdminDemo" styleClass="button-secondary" text="Cargar administrador" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
