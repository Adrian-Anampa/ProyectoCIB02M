<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760" prefWidth="1180" stylesheets="@../css/app.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.uni.campusfind.controller.RegistroController">
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="430" spacing="20" styleClass="brand-panel">
            <padding><Insets bottom="60" left="55" right="55" top="60"/></padding>
            <Label styleClass="brand-mark" text="ENCUENTRA+"/>
            <Label maxWidth="320" styleClass="hero-title" text="Únete a una comunidad que ayuda." wrapText="true"/>
            <Label maxWidth="320" styleClass="hero-copy" text="Registra tu cuenta institucional para publicar hallazgos y recuperar tus pertenencias." wrapText="true"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="edge-to-edge">
            <StackPane styleClass="page-background">
                <VBox maxWidth="560" spacing="15" styleClass="auth-card">
                    <Label styleClass="eyebrow" text="NUEVA CUENTA"/>
                    <Label styleClass="page-title" text="Registro de estudiante"/>
                    <Label styleClass="muted-text" text="Los campos marcados con * son obligatorios."/>
                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Nombres *"/><TextField fx:id="firstNameField" promptText="Nombres"/></VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Apellidos *"/><TextField fx:id="lastNameField" promptText="Apellidos"/></VBox>
                    </HBox>
                    <VBox spacing="6"><Label styleClass="field-label" text="Correo electrónico *"/><TextField fx:id="emailField" promptText="nombre@institucion.edu.pe"/></VBox>
                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Contraseña *"/><PasswordField fx:id="passwordField" promptText="Mínimo 8 caracteres"/></VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label styleClass="field-label" text="Confirmar contraseña *"/><PasswordField fx:id="confirmationField" onAction="#onRegister" promptText="Repite la contraseña"/></VBox>
                    </HBox>
                    <Label styleClass="helper-text" text="La contraseña se almacena protegida mediante BCrypt."/>
                    <Label fx:id="messageLabel" minHeight="24" styleClass="form-message" wrapText="true"/>
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button cancelButton="true" onAction="#onBack" styleClass="button-secondary" text="Volver"/>
                        <Button defaultButton="true" onAction="#onRegister" styleClass="button-primary" text="Crear cuenta"/>
                    </HBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
